{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucasgaldinos/gpu_accelerated_clean/configs/schemas/algorithms.schema.json",
  "title": "Algorithm variants configuration",
  "description": "Declarative GA composition (Design B, DP11-1) or monolithic class loading. Every strategy class named here must exist in algorithms.strategies.STRATEGY_REGISTRY, and every parameter key must be accepted by the class constructor (DP11-5, BUG-85).",
  "type": "object",
  "required": [
    "default_params",
    "algorithm_configs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference used by editors for completion and validation."
    },
    "default_params": {
      "type": "object",
      "description": "Genetic Algorithm defaults applied to every variant unless overridden.",
      "required": [
        "population_size",
        "mutation_rate",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "population_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of individuals kept per generation."
        },
        "mutation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Per-individual probability of applying the mutation operator."
        },
        "seed": {
          "type": "integer",
          "description": "Base random seed; repetitions offset it."
        }
      }
    },
    "algorithm_configs": {
      "type": "object",
      "description": "Variant name -> configuration. Variant names are the labels reported in checkpoints and statistics.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/algorithm_config"
      }
    }
  },
  "$defs": {
    "algorithm_config": {
      "type": "object",
      "required": [
        "metaheuristic",
        "use_gpu",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "metaheuristic": {
          "type": "string",
          "description": "Metaheuristic identifier; `GeneticAlgorithm` selects the modular pipeline, any other value requires `class_module`/`class_name`.",
          "examples": [
            "GeneticAlgorithm",
            "GeneticAlgorithmFullGPUMonolithic"
          ]
        },
        "use_gpu": {
          "type": "boolean",
          "description": "Whether the variant needs CuPy/CUDA at run time (the benchmark skips GPU variants when no device is present)."
        },
        "description": {
          "type": "string",
          "description": "Human-readable label copied into reports."
        },
        "class_module": {
          "type": "string",
          "description": "Dotted module path for monolithic variants resolved by `AlgorithmConfig.get_class()`.",
          "examples": [
            "algorithms.archive.full_gpu_monolithic"
          ]
        },
        "class_name": {
          "type": "string",
          "description": "Class name inside `class_module`.",
          "examples": [
            "GeneticAlgorithmFullGPUMonolithic"
          ]
        },
        "params": {
          "type": "object",
          "description": "Algorithm-level parameters. Modular pipelines accept `pipeline`, `local_search_stage`, `population_size`, `mutation_rate` and `seed`.",
          "properties": {
            "pipeline": {
              "type": "array",
              "description": "Optional list of generational pipeline step specifications (DP11-6, DP11-10).",
              "items": {
                "$ref": "#/$defs/pipeline_step"
              }
            },
            "local_search_stage": {
              "$ref": "#/$defs/local_search_stage"
            },
            "population_size": {
              "type": "integer",
              "minimum": 1
            },
            "mutation_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "seed": {
              "type": "integer"
            },
            "tournament_size": {
              "type": "integer",
              "minimum": 2,
              "description": "Monolithic-only alias of the selection tournament size."
            },
            "two_opt_iterations": {
              "type": "integer",
              "minimum": 0,
              "description": "Monolithic-only alias of the 2-opt pass cap."
            }
          },
          "additionalProperties": false
        },
        "strategies": {
          "type": "object",
          "description": "Strategy slot -> class + parameters (Design B). Slots omitted from the pipeline stay `None`.",
          "additionalProperties": false,
          "properties": {
            "initialization": {
              "$ref": "#/$defs/strategy_slot"
            },
            "selection": {
              "$ref": "#/$defs/strategy_slot"
            },
            "crossover": {
              "$ref": "#/$defs/strategy_slot"
            },
            "mutation": {
              "$ref": "#/$defs/strategy_slot"
            },
            "local_search": {
              "$ref": "#/$defs/strategy_slot"
            },
            "evaluation": {
              "$ref": "#/$defs/strategy_slot"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metaheuristic": {
                "not": {
                  "const": "GeneticAlgorithm"
                }
              }
            }
          },
          "then": {
            "required": [
              "class_module",
              "class_name"
            ]
          }
        }
      ]
    },
    "local_search_stage": {
      "type": "string",
      "enum": [
        "post_crossover",
        "post_mutation",
        "post_evaluation",
        "post_evolution",
        "none"
      ],
      "description": "Where the local-search strategy runs inside the generation pipeline (`LocalSearchStage`)."
    },
    "strategy_slot": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "description": "Optional dotted Python module path for loading an external custom class outside the built-in registry without modifying src/."
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "description": "Key of `STRATEGY_REGISTRY`; the slot prefix identifies the stage."
        },
        "params": {
          "type": "object",
          "description": "Constructor keyword arguments validated per selected strategy class via `allOf`."
        }
      },
      "if": {
        "not": {
          "required": [
            "module"
          ]
        }
      },
      "then": {
        "properties": {
          "class": {
            "enum": [
              "CrossoverGPUOrder",
              "CrossoverOrder",
              "CrossoverPartiallyMapped",
              "EvaluationCPUCost",
              "EvaluationGPUCost",
              "InitializationNearestNeighbor",
              "InitializationRandom",
              "LocalSearchCPUTwoOpt",
              "LocalSearchGPUTwoOpt",
              "LocalSearchNoOp",
              "MutationGPUInversion",
              "MutationGPUSwap",
              "MutationInversion",
              "MutationSwap",
              "SelectionGPUTournament",
              "SelectionRouletteWheel",
              "SelectionTournament"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "CrossoverGPUOrder"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_crossover_gpu_order"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "CrossoverOrder"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_crossover_order"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "CrossoverPartiallyMapped"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_crossover_partially_mapped"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "EvaluationCPUCost"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_evaluation_cpu_cost"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "EvaluationGPUCost"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_evaluation_gpu_cost"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "InitializationNearestNeighbor"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_initialization_nearest_neighbor"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "InitializationRandom"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_initialization_random"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "LocalSearchCPUTwoOpt"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_local_search_cpu_two_opt"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "LocalSearchGPUTwoOpt"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_local_search_gpu_two_opt"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "LocalSearchNoOp"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_local_search_no_op"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "MutationGPUInversion"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_mutation_gpu_inversion"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "MutationGPUSwap"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_mutation_gpu_swap"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "MutationInversion"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_mutation_inversion"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "MutationSwap"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_mutation_swap"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "SelectionGPUTournament"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_selection_gpu_tournament"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "SelectionRouletteWheel"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_selection_roulette_wheel"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "SelectionTournament"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_selection_tournament"
              }
            }
          }
        }
      ]
    },
    "pipeline_step": {
      "type": "object",
      "required": [
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "description": "Optional dotted Python module path for loading an external custom class outside the built-in registry without modifying src/."
        },
        "class": {
          "type": "string",
          "minLength": 1,
          "description": "Key of `PIPELINE_STEP_REGISTRY`."
        },
        "params": {
          "type": "object",
          "description": "Constructor keyword arguments validated per selected pipeline step class via `allOf`."
        }
      },
      "if": {
        "not": {
          "required": [
            "module"
          ]
        }
      },
      "then": {
        "properties": {
          "class": {
            "enum": [
              "EliteOnlyLocalSearchStep",
              "PeriodicLocalSearchStep",
              "PostInitLocalSearchStep"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "EliteOnlyLocalSearchStep"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_elite_only_local_search_step"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "PeriodicLocalSearchStep"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_periodic_local_search_step"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "module"
              ]
            },
            "required": [
              "class"
            ],
            "properties": {
              "class": {
                "const": "PostInitLocalSearchStep"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/params_post_init_local_search_step"
              }
            }
          }
        }
      ]
    },
    "params_crossover_gpu_order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        }
      }
    },
    "params_crossover_order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        }
      }
    },
    "params_crossover_partially_mapped": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        }
      }
    },
    "params_evaluation_cpu_cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "params_evaluation_gpu_cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "return_gpu": {
          "type": "boolean",
          "description": "Keep produced routes/costs in VRAM instead of returning host arrays."
        },
        "threads_per_block": {
          "type": "integer",
          "minimum": 32,
          "$comment": "Advisory bound: GPU strategies clamp or derive block dimensions at runtime.",
          "description": "CUDA threads per block for the GPU strategies (advisory lower bound)."
        },
        "max_matrix_dimension": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: n threshold for on-the-fly distances; null defers to DEFAULT_MAX_MATRIX_DIMENSION.",
          "description": "`n` above which coordinate-based problems use on-the-fly distances; `null` defers to `DEFAULT_MAX_MATRIX_DIMENSION` (10 000)."
        }
      }
    },
    "params_initialization_nearest_neighbor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Advisory bound: tournament size or candidate-list width >= 1.",
          "description": "Tournament size (selection) or candidate-list width (initialization)."
        },
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        },
        "return_gpu": {
          "type": "boolean",
          "description": "Keep produced routes/costs in VRAM instead of returning host arrays."
        },
        "candidate_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: <= 0 or null disables candidate-list pruning.",
          "description": "Nearest-neighbour list width; null or <= 0 keeps the exhaustive scan (DP10-20)."
        }
      }
    },
    "params_initialization_random": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        },
        "return_gpu": {
          "type": "boolean",
          "description": "Keep produced routes/costs in VRAM instead of returning host arrays."
        }
      }
    },
    "params_local_search_cpu_two_opt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Advisory bound: 0 disables 2-opt refinement passes.",
          "description": "2-opt pass cap for the local-search strategies."
        },
        "mode": {
          "type": "string",
          "enum": [
            "best",
            "first",
            "multi_move"
          ],
          "description": "Acceptance rule supported by this strategy's backend."
        },
        "candidate_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: <= 0 or null disables candidate-list pruning.",
          "description": "Nearest-neighbour list width; null or <= 0 keeps the exhaustive scan (DP10-20)."
        }
      }
    },
    "params_local_search_gpu_two_opt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Advisory bound: 0 disables 2-opt refinement passes.",
          "description": "2-opt pass cap for the local-search strategies."
        },
        "mode": {
          "type": "string",
          "enum": [
            "batch",
            "multi_move",
            "naive"
          ],
          "description": "Acceptance rule supported by this strategy's backend."
        },
        "threads_per_block": {
          "type": "integer",
          "minimum": 32,
          "$comment": "Advisory bound: GPU strategies clamp or derive block dimensions at runtime.",
          "description": "CUDA threads per block for the GPU strategies (advisory lower bound)."
        },
        "max_matrix_dimension": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: n threshold for on-the-fly distances; null defers to DEFAULT_MAX_MATRIX_DIMENSION.",
          "description": "`n` above which coordinate-based problems use on-the-fly distances; `null` defers to `DEFAULT_MAX_MATRIX_DIMENSION` (10 000)."
        },
        "max_shared_tour_cities": {
          "type": "integer",
          "minimum": 2,
          "$comment": "Advisory bound: minimum tour size for shared-memory caching.",
          "description": "`n` above which the GPU 2-opt scans the tour tile by tile instead of caching it in shared memory (default 11 520)."
        },
        "candidate_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: <= 0 or null disables candidate-list pruning.",
          "description": "Nearest-neighbour list width; null or <= 0 keeps the exhaustive scan (DP10-20)."
        }
      }
    },
    "params_local_search_no_op": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 0,
          "$comment": "Advisory bound: 0 disables 2-opt refinement passes.",
          "description": "2-opt pass cap for the local-search strategies."
        }
      }
    },
    "params_mutation_gpu_inversion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        },
        "candidate_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "$comment": "Advisory bound: <= 0 or null disables candidate-list pruning.",
          "description": "Nearest-neighbour list width; null or <= 0 keeps the exhaustive scan (DP10-20)."
        }
      }
    },
    "params_mutation_gpu_swap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": [
            "integer",
            "array",
            "null"
          ],
          "description": "Explicit seed override; the loader injects the run seed when omitted."
        },
        "candidate_k": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
