{
  "ga_params": {
    "population_size": 256,
    "mutation_rate": 0.02,
    "tournament_size": 5,
    "two_opt_iterations": 10,
    "seed": 42
  },
  "algorithm_configs": {
    "CPU": {
      "class_module": "algorithms.presets",
      "class_name": "GeneticAlgorithmCPU",
