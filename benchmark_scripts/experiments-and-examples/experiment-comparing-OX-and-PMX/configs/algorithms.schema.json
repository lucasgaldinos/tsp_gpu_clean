        {
          "title": "CrossoverGPUPartiallyMapped (external: ../gpu_pmx_crossover.py)",
          "type": "object",
          "required": [
            "module",
            "class"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "const": "../gpu_pmx_crossover.py",
              "description": "External Python module path or config-relative .py file path."
            },
            "class": {
              "const": "CrossoverGPUPartiallyMapped",
              "description": "External custom crossover strategy class exported by `../gpu_pmx_crossover.py`."
            },
            "params": {
              "$ref": "#/$defs/params_ext_gpu_pmx_crossover_py_crossover_gpu_partially_mapped",
              "description": "Constructor keyword arguments for this `crossover` strategy class."
            }
          }
        },
        {
          "title": "External custom crossover strategy (module + class)",
          "type": "object",
          "required": [
            "module",
            "class"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "description": "Dotted Python module path or config-relative .py file path for loading an external custom class outside the built-in registry without modifying src/."
            },
            "class": {
              "type": "string",
              "minLength": 1,
              "description": "External custom crossover strategy class name exported by `module`."
            },
            "params": {
              "type": "object",
              "description": "Constructor keyword arguments passed to the external custom class."
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "module",
                  "class"
                ],
                "properties": {
                  "module": {
                    "const": "../gpu_pmx_crossover.py"
                  },
                  "class": {
                    "const": "CrossoverGPUPartiallyMapped"
                  }
                }
              }
            ]
          }
        }
      ]
    },
