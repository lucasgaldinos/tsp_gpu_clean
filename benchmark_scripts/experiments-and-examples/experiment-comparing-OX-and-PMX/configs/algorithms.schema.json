{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lucasgaldinos/gpu_accelerated_clean/configs/schemas/algorithms.schema.json",
  "title": "Algorithm variants configuration",
  "description": "Declarative GA composition (Design B, DP11-1) or monolithic class loading. Built-in strategies and pipeline steps are partitioned by PEP 544 protocol slots and validated against constructor signatures via discriminated `oneOf` branches; external custom classes are supported via `module` + `class` without modifying src/ (DP11-5, BUG-85, BUG-103).",
  "type": "object",
  "required": [
    "default_params",
    "algorithm_configs"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference used by editors for completion and validation."
    },
    "default_params": {
      "type": "object",
      "description": "Genetic Algorithm defaults applied to every variant unless overridden.",
      "required": [
        "population_size",
        "mutation_rate",
        "seed"
      ],
      "additionalProperties": false,
      "properties": {
        "population_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of individuals kept per generation."
        },
        "mutation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Per-individual probability of applying the mutation operator."
        },
        "seed": {
          "type": "integer",
          "description": "Base random seed; repetitions offset it."
        }
      }
    },
    "algorithm_configs": {
      "type": "object",
      "description": "Variant name -> configuration. Variant names are the labels reported in checkpoints and statistics.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/algorithm_config"
      }
    }
  },
  "$defs": {
    "algorithm_config": {
      "type": "object",
      "oneOf": [
        {
          "title": "Modular GeneticAlgorithm",
          "type": "object",
          "required": [
            "metaheuristic",
            "use_gpu",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "metaheuristic": {
              "const": "GeneticAlgorithm",
              "description": "Selects the modular strategy-driven `GeneticAlgorithm` pipeline."
            },
            "use_gpu": {
              "type": "boolean",
              "description": "Whether the variant needs CuPy/CUDA at run time (the benchmark skips GPU variants when no device is present)."
            },
            "description": {
              "type": "string",
              "description": "Human-readable label copied into reports."
            },
            "params": {
              "type": "object",
              "description": "Modular `GeneticAlgorithm` parameters: `pipeline`, `local_search_stage`, `population_size`, `mutation_rate`, and `seed`.",
              "additionalProperties": false,
              "properties": {
                "pipeline": {
                  "type": "array",
                  "description": "Optional list of generational pipeline step specifications (DP11-6, DP11-10).",
                  "items": {
                    "$ref": "#/$defs/pipeline_step"
                  }
                },
                "local_search_stage": {
                  "$ref": "#/$defs/local_search_stage"
                },
                "population_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "mutation_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "seed": {
                  "type": "integer"
                }
              }
            },
            "strategies": {
              "type": "object",
              "description": "Strategy slot -> class + parameters (Design B). Slots omitted from the pipeline stay `None`.",
              "additionalProperties": false,
              "properties": {
                "initialization": {
                  "$ref": "#/$defs/strategy_slot_initialization"
                },
                "selection": {
                  "$ref": "#/$defs/strategy_slot_selection"
                },
                "crossover": {
                  "$ref": "#/$defs/strategy_slot_crossover"
                },
                "mutation": {
                  "$ref": "#/$defs/strategy_slot_mutation"
                },
                "local_search": {
                  "$ref": "#/$defs/strategy_slot_local_search"
                },
                "evaluation": {
                  "$ref": "#/$defs/strategy_slot_evaluation"
                }
              }
            }
          }
        },
        {
          "title": "Monolithic Algorithm Class",
          "type": "object",
          "required": [
            "metaheuristic",
            "use_gpu",
            "description",
            "class_module",
            "class_name"
          ],
          "additionalProperties": false,
          "properties": {
            "metaheuristic": {
              "type": "string",
              "minLength": 1,
              "not": {
                "const": "GeneticAlgorithm"
              },
              "description": "Non-modular metaheuristic identifier loaded dynamically via `class_module`/`class_name`.",
              "examples": [
                "GeneticAlgorithmFullGPUMonolithic"
              ]
            },
            "use_gpu": {
              "type": "boolean",
              "description": "Whether the variant needs CuPy/CUDA at run time (the benchmark skips GPU variants when no device is present)."
            },
            "description": {
              "type": "string",
              "description": "Human-readable label copied into reports."
            },
            "class_module": {
              "type": "string",
              "minLength": 1,
              "description": "Dotted module path or config-relative .py file path for monolithic variants resolved by `AlgorithmConfig.get_class()`.",
              "examples": [
                "algorithms.archive.full_gpu_monolithic"
              ]
            },
            "class_name": {
              "type": "string",
              "minLength": 1,
              "description": "Class name inside `class_module`.",
              "examples": [
                "GeneticAlgorithmFullGPUMonolithic"
              ]
            },
            "params": {
              "type": "object",
              "description": "Constructor keyword arguments forwarded to the monolithic algorithm class.",
              "additionalProperties": true,
              "properties": {
                "local_search_stage": {
                  "$ref": "#/$defs/local_search_stage"
                },
                "population_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "mutation_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "seed": {
                  "type": "integer"
                },
                "tournament_size": {
                  "type": "integer",
                  "minimum": 2,
                  "description": "Monolithic-only alias of the selection tournament size."
                },
                "two_opt_iterations": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Monolithic-only alias of the 2-opt pass cap."
                }
              }
            }
          }
        }
      ]
    },
    "local_search_stage": {
      "type": "string",
      "enum": [
        "post_crossover",
        "post_mutation",
        "post_evaluation",
        "post_evolution",
        "none"
      ],
      "description": "Where the local-search strategy runs inside the generation pipeline (`LocalSearchStage`)."
    },
    "strategy_slot_initialization": {
      "type": "object",
      "oneOf": [
        {
          "title": "InitializationNearestNeighbor",
          "type": "object",
          "required": [
            "class"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "const": "InitializationNearestNeighbor",
              "description": "Built-in `InitializationStrategy` implementation registered in `STRATEGY_REGISTRY`."
            },
            "params": {
              "$ref": "#/$defs/params_initialization_nearest_neighbor",
              "description": "Constructor keyword arguments for this `initialization` strategy class."
            }
          }
        },
        {
          "title": "InitializationRandom",
          "type": "object",
          "required": [
            "class"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "const": "InitializationRandom",
              "description": "Built-in `InitializationStrategy` implementation registered in `STRATEGY_REGISTRY`."
            },
            "params": {
              "$ref": "#/$defs/params_initialization_random",
              "description": "Constructor keyword arguments for this `initialization` strategy class."
            }
          }
        },
        {
          "title": "External custom initialization strategy (module + class)",
          "type": "object",
          "required": [
            "module",
            "class"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "description": "Dotted Python module path or config-relative .py file path for loading an external custom class outside the built-in registry without modifying src/."
            },
            "class": {
              "type": "string",
              "minLength": 1,
              "description": "External custom initialization strategy class name exported by `module`."
            },
            "params": {
              "type": "object",
              "description": "Constructor keyword arguments passed to the external custom class."
            }
          }
        }
      ]
    },
