{
  "$schema": "./algorithms.schema.json",
  "default_params": {
    "population_size": 128,
    "mutation_rate": 0.03,
    "seed": 42
  },
  "algorithm_configs": {
    "TwoOpt_Batch_GPU": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": true,
      "description": "Device-resident GPU memetic GA with candidate-list single-steepest batched 2-opt",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": true
          }
        },
        "selection": {
          "class": "SelectionGPUTournament",
          "params": {
            "k": 5
          }
        },
        "crossover": {
          "class": "CrossoverGPUPermOrder"
        },
        "mutation": {
          "class": "MutationGPUPermSwap"
        },
        "local_search": {
          "class": "LocalSearchGPUTourTwoOpt",
          "params": {
            "mode": "batch",
            "max_iterations": 10,
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationGPUCost",
          "params": {
            "return_gpu": true
          }
        }
      }
    },
    "TwoOpt_MultiMove_GPU": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": true,
      "description": "Device-resident GPU memetic GA with candidate-list disjoint multi-move 2-opt",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": true
          }
        },
        "selection": {
          "class": "SelectionGPUTournament",
          "params": {
            "k": 5
          }
        },
        "crossover": {
          "class": "CrossoverGPUPermOrder"
        },
        "mutation": {
          "class": "MutationGPUPermSwap"
        },
        "local_search": {
          "class": "LocalSearchGPUTourTwoOpt",
          "params": {
            "mode": "multi_move",
            "max_iterations": 10,
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationGPUCost",
          "params": {
            "return_gpu": true
          }
        }
      }
    },
