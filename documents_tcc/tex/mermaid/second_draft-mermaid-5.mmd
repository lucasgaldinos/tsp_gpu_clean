    classDiagram
    direction TB

    class Orchestration {
        <<module>>
        +run_comprehensive_benchmark()
      }

    class CheckpointManager {
        +checkpoint_dir: Path
        +ensure_directories()
        +get_checkpoint_path()
        +list_checkpoints()
      }

    class CheckpointIO {
        <<module>>
        +is_valid_checkpoint()
        +can_resume_checkpoint()
        +get_remaining_repetitions()
      }

    class GeneticAlgorithm {
        +population_size: int
        +mutation_rate: float
        +evolve()
        +timer: PhaseTimer
        -initialization
        -selection
        -crossover
        -mutation
        -local_search
        -evaluation
      }

    class InitializationStrategy {
        <<Protocol>>
        +initialize()
      }

    class SelectionStrategy {
        <<Protocol>>
        +select()
      }

    class CrossoverStrategy {
        <<Protocol>>
        +crossover()
      }

    class MutationStrategy {
        <<Protocol>>
        +mutate()
      }

    class LocalSearchStrategy {
        <<Protocol>>
        +improve()
        +improve_batch()
      }

    class EvaluationStrategy {
        <<Protocol>>
        +evaluate()
      }

    Orchestration --> CheckpointManager : Uses
    Orchestration --> CheckpointIO : Calls
    Orchestration --> GeneticAlgorithm : Instantiates & Runs
    GeneticAlgorithm o--> InitializationStrategy
    GeneticAlgorithm o--> SelectionStrategy
    GeneticAlgorithm o--> CrossoverStrategy
    GeneticAlgorithm o--> MutationStrategy
    GeneticAlgorithm o--> LocalSearchStrategy
    GeneticAlgorithm o--> EvaluationStrategy

    note for GeneticAlgorithm "Composição de estratégias:<br>a variante escolhe quais implementações<br>ocupam as seis etapas; não há subclasses.<br>As etapas de CPU e de GPU compartilham o mesmo contrato."
