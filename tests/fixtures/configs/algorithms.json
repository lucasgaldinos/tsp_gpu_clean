{
  "$schema": "../../../configs/schemas/algorithms.schema.json",
  "default_params": {
    "population_size": 32,
    "mutation_rate": 0.05,
    "seed": 42
  },
  "algorithm_configs": {
    "CPU": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": false,
      "description": "Pure NumPy CPU baseline with 2-opt local search",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": false
          }
        },
        "selection": {
          "class": "SelectionTournament",
          "params": {
            "k": 3
          }
        },
        "crossover": {
          "class": "CrossoverOrder"
        },
        "mutation": {
          "class": "MutationSwap"
        },
        "local_search": {
          "class": "LocalSearchCPUTwoOpt",
          "params": {
            "max_iterations": 5,
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationCPUCost"
        }
      }
    },
    "HybridNaive": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": true,
      "description": "GPU operators with naive per-route memory transfers",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": false
          }
        },
        "selection": {
          "class": "SelectionTournament",
          "params": {
            "k": 3
          }
        },
        "crossover": {
          "class": "CrossoverOrder"
        },
        "mutation": {
          "class": "MutationSwap"
        },
        "local_search": {
          "class": "LocalSearchGPUTwoOpt",
          "params": {
            "max_iterations": 5,
            "mode": "naive",
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationCPUCost"
        }
      }
    },
    "HybridOptimized": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": true,
      "description": "GPU operators with batch transfers and batch GPU 2-opt",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": false
          }
        },
        "selection": {
          "class": "SelectionTournament",
          "params": {
            "k": 3
          }
        },
        "crossover": {
          "class": "CrossoverOrder"
        },
        "mutation": {
          "class": "MutationSwap"
        },
        "local_search": {
          "class": "LocalSearchGPUTwoOpt",
          "params": {
            "max_iterations": 5,
            "mode": "batch",
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationGPUCost",
          "params": {
            "return_gpu": false
          }
        }
      }
    },
    "FullGPUModular": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": true,
      "description": "Modular Full-GPU pipeline with per-phase CUDA kernels",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "InitializationRandom",
          "params": {
            "return_gpu": true
          }
        },
        "selection": {
          "class": "SelectionGPUTournament",
          "params": {
            "k": 3
          }
        },
        "crossover": {
          "class": "CrossoverGPUOrder"
        },
        "mutation": {
          "class": "MutationGPUSwap"
        },
        "local_search": {
          "class": "LocalSearchGPUTwoOpt",
          "params": {
            "max_iterations": 5,
            "mode": "batch",
            "candidate_k": 20
          }
        },
        "evaluation": {
          "class": "EvaluationGPUCost",
          "params": {
            "return_gpu": true
          }
        }
      }
    }
  }
}

