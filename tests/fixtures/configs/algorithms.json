{
  "default_params": {
    "population_size": 32,
    "mutation_rate": 0.05,
    "seed": 42
  },
  "algorithm_configs": {
    "CPU": {
      "metaheuristic": "GeneticAlgorithm",
      "use_gpu": false,
      "description": "Pure NumPy CPU baseline with 2-opt local search",
      "params": {
        "local_search_stage": "post_mutation"
      },
      "strategies": {
        "initialization": {
          "class": "RandomPermutationInitialization",
          "params": {
            "return_gpu": false
          }
        },
        "selection": {
          "class": "TournamentSelection",
          "params": {
            "k": 3
          }
        },
        "crossover": {
          "class": "OrderCrossover"
        },
        "mutation": {
          "class": "SwapMutation"
        },
        "local_search": {
          "class": "CPUTwoOpt",
          "params": {
            "max_iterations": 5
          }
        },
        "evaluation": {
          "class": "CPUCostEvaluation"
        }
      }
    },
